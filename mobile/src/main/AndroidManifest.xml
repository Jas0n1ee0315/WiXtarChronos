<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="WiXtar 打卡"
        android:supportsRtl="true"
        android:theme="@style/Theme.WiXtarCompanion">

        <activity
            android:name="com.jas0n1ee.wixtar.chronos.mobile.presentation.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.WiXtarCompanion">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <service
            android:name="com.jas0n1ee.wixtar.chronos.mobile.service.MobileWearableListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <service
            android:name="com.jas0n1ee.wixtar.chronos.mobile.service.WiXtarTileService"
            android:icon="@drawable/ic_cloud_clock"
            android:label="WiXtar 打卡"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name="com.jas0n1ee.wixtar.chronos.mobile.widget.PunchWidget2x1Provider"
            android:label="方形"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_2x1_info" />
        </receiver>

        <receiver
            android:name="com.jas0n1ee.wixtar.chronos.mobile.widget.PunchWidget2x1TranslucentProvider"
            android:label="方形 (半透)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_2x1_translucent_info" />
        </receiver>

        <receiver
            android:name="com.jas0n1ee.wixtar.chronos.mobile.widget.PunchWidgetStadiumProvider"
            android:label="膠囊"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_stadium_info" />
        </receiver>

        <receiver
            android:name="com.jas0n1ee.wixtar.chronos.mobile.widget.PunchWidgetStadiumTranslucentProvider"
            android:label="膠囊 (半透)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_stadium_translucent_info" />
        </receiver>

        <receiver
            android:name="com.jas0n1ee.wixtar.chronos.mobile.widget.PunchWidgetCircleProvider"
            android:label="圓形"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_circle_info" />
        </receiver>

        <receiver
            android:name="com.jas0n1ee.wixtar.chronos.mobile.widget.PunchWidgetCircleTranslucentProvider"
            android:label="圓形 (半透)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_circle_translucent_info" />
        </receiver>

        <receiver
            android:name="com.jas0n1ee.wixtar.chronos.mobile.widget.PunchWidget1x1Provider"
            android:label="小小方"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_1x1_info" />
        </receiver>

        <receiver
            android:name="com.jas0n1ee.wixtar.chronos.mobile.widget.PunchWidget1x1TranslucentProvider"
            android:label="小小方 (半透)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_1x1_translucent_info" />
        </receiver>

        <receiver
            android:name="com.jas0n1ee.wixtar.chronos.mobile.widget.PunchWidget1x1CircleProvider"
            android:label="小小圓"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_1x1_circle_info" />
        </receiver>

        <receiver
            android:name="com.jas0n1ee.wixtar.chronos.mobile.widget.PunchWidget1x1CircleTranslucentProvider"
            android:label="小小圓 (半透)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_1x1_circle_translucent_info" />
        </receiver>

        <receiver
            android:name="com.jas0n1ee.wixtar.chronos.mobile.widget.PunchWidgetActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.jas0n1ee.wixtar.chronos.ACTION_PUNCH_CARD" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.jas0n1ee.wixtar.chronos.mobile.notification.OffWorkNotificationActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.jas0n1ee.wixtar.chronos.ACTION_OFF_WORK_PUNCH" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.jas0n1ee.wixtar.chronos.mobile.notification.FishOilActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.jas0n1ee.wixtar.chronos.ACTION_FISH_OIL_EATEN" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.jas0n1ee.wixtar.chronos.mobile.notification.NotificationReceiver"
            android:exported="false" />

        <receiver
            android:name="com.jas0n1ee.wixtar.chronos.mobile.receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
