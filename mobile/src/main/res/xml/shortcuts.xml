<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Built-in Intent: OPEN_APP_FEATURE -->
    <capability android:name="actions.intent.OPEN_APP_FEATURE">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.jas0n1ee.wixtar.chronos"
            android:targetClass="com.jas0n1ee.wixtar.chronos.mobile.presentation.MainActivity">
            <parameter
                android:name="feature"
                android:key="feature" />
            <extra
                android:name="action"
                android:value="PUNCH_CARD" />
        </intent>
    </capability>

    <!-- Custom Capability for Direct Punch Card -->
    <capability android:name="custom.actions.intent.PUNCH_CARD">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.jas0n1ee.wixtar.chronos"
            android:targetClass="com.jas0n1ee.wixtar.chronos.mobile.presentation.MainActivity">
            <extra
                android:name="action"
                android:value="PUNCH_CARD" />
        </intent>
    </capability>

    <shortcut
        android:shortcutId="punch_card_shortcut"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_cloud_clock"
        android:shortcutShortLabel="@string/shortcut_punch_card_label"
        android:shortcutLongLabel="@string/shortcut_punch_card_long_label">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.jas0n1ee.wixtar.chronos"
            android:targetClass="com.jas0n1ee.wixtar.chronos.mobile.presentation.MainActivity">
            <extra
                android:name="action"
                android:value="PUNCH_CARD" />
        </intent>
        <capability-binding android:key="actions.intent.OPEN_APP_FEATURE">
            <parameter-binding
                android:key="feature"
                android:value="打卡" />
        </capability-binding>
        <capability-binding android:key="custom.actions.intent.PUNCH_CARD" />
    </shortcut>

</shortcuts>
